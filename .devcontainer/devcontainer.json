{
	"name": "devicecode-lua",
	"image": "ghcr.io/jangala-dev/mini-lua-image:latest",
	"remoteUser": "vscode",
	"postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
	"forwardPorts": [
		8081,
		2222,
		2242
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"sumneko.lua",
				"rog2.luacheck",
				"bierner.markdown-mermaid"
			]
		}
	},
	"runArgs": [
		"--dns=1.1.1.1",
		"--dns=8.8.8.8"
	]
}
