{
	"name": "devicecode-lua",
	"image": "ghcr.io/jangala-dev/mini-lua-image:latest",
	"remoteUser": "vscode",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22"
		}
	},
	"postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
	"forwardPorts": [
		8081,
		2222,
		2242
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"sumneko.lua",
				"rog2.luacheck",
				"bierner.markdown-mermaid"
			]
		}
	}
}
