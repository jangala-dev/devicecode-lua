#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
VM_DIR="$(dirname "$SCRIPT_DIR")"

# shellcheck disable=SC1091
. "$VM_DIR/env.sh"

if [ "$#" -ne 2 ]; then
	echo "usage: $0 LOCAL_PATH REMOTE_PATH" >&2
	exit 2
fi

exec scp \
	-q \
	-O \
	-o StrictHostKeyChecking=no \
	-o UserKnownHostsFile=/dev/null \
	-o LogLevel=ERROR \
	-P "${OPENWRT_SSH_PORT}" \
	-r \
	"$1" "root@127.0.0.1:$2"
