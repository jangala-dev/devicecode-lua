#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
VM_DIR="$(dirname "$SCRIPT_DIR")"

# shellcheck disable=SC1091
. "$VM_DIR/env.sh"

if [ -f "${OPENWRT_PID}" ]; then
	pid="$(cat "${OPENWRT_PID}")"
	if kill -0 "$pid" 2>/dev/null; then
		echo "[openwrt-vm] stopping pid ${pid}"
		kill "$pid" || true
		sleep 1
		if kill -0 "$pid" 2>/dev/null; then
			kill -9 "$pid" || true
		fi
	fi
	rm -f "${OPENWRT_PID}"
fi
